{
  "name": "tshow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TShow desktop shell with local-only native player handoff",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fun.showt.desktop",
    "productName": "TShow",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "security.js",
      "player.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "TShow-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
