{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tshow",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "showt.fun",
      "custom_domain": true
    },
    {
      "pattern": "www.showt.fun",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node scripts/build-cloudflare.js"
  },
  "assets": {
    "directory": "./.cloudflare-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api",
      "/api/*",
      "/movie/*",
      "/series/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tshow-accounts",
      "database_id": "7e00b088-a8b6-4d11-baa6-aa2895791fb1",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://showt.fun"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
