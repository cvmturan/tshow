{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tshow",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "showt.fun",
      "custom_domain": true
    },
    {
      "pattern": "www.showt.fun",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node scripts/build-cloudflare.js"
  },
  "assets": {
    "directory": "./.cloudflare-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/movie/*", "/series/*"]
  },
  "vars": {
    "API_ORIGIN": "https://tshow.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
