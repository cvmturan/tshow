# Listen on this computer and other devices on the same trusted home network.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Set to 1 when the app runs behind one trusted reverse proxy, such as Render.
TRUST_PROXY=

# Optional. StreamFlix automatically uses its offline demo catalog without a key.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional user-owned service tokens. Keep these only in your local .env file.
REALDEBRID_API_TOKEN=
ALLDEBRID_API_TOKEN=
PREMIUMIZE_API_TOKEN=
TORBOX_API_TOKEN=
ALLOW_RUNTIME_DEBRID_CONFIG=false
# Required to expose any /api/debrid route. Use a random value of at least 24 characters.
DEBRID_API_ACCESS_KEY=

# Private/LAN manifest URLs are blocked by default to protect the server from
# server-side request forgery. Manual add-on URLs are stored in each browser.
ALLOW_PRIVATE_ADDONS=false

# Leave empty unless you explicitly trust a Stremio-compatible repository.
ADDON_REPOSITORY_URL=
CACHE_TTL_MS=3600000
