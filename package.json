{
  "name": "tshow",
  "version": "1.2.0",
  "private": true,
  "description": "TShow: a local-first movie and series discovery PWA with manual add-ons",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-cloudflare.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cf:build": "node scripts/build-cloudflare.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run",
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.0.0",
    "hls.js": "^1.6.13"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
